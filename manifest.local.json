{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/vDevPreview/MicrosoftTeams.schema.json",
  "manifestVersion": "devPreview",
  "version": "1.0.0",
  "id": "f1b2c3d4-e5f6-7890-abcd-ef1234567890",
  "developer": {
    "name": "FormulaBridge",
    "websiteUrl": "https://localhost:3000",
    "privacyUrl": "https://localhost:3000/privacy",
    "termsOfUseUrl": "https://localhost:3000/terms"
  },
  "name": {
    "short": "FormulaBridge (Local)",
    "full": "FormulaBridge – Excel Formula Translator (Local)"
  },
  "description": {
    "short": "Write Excel formulas in any language",
    "full": "FormulaBridge automatically translates Excel formulas between 18 languages. Type =SUMME(A1:A10) in an English Excel, =SOMME(A1:A10) in a German one – FormulaBridge translates instantly."
  },
  "icons": {
    "outline": "assets/icon-32.png",
    "color": "assets/icon-80.png"
  },
  "accentColor": "#4F6BED",
  "extensions": {
    "requirements": {
      "capabilities": [
        {
          "name": "Workbook",
          "minVersion": "1.1"
        }
      ],
      "scopes": ["personal"]
    },
    "runtimes": [
      {
        "id": "TaskPaneRuntime",
        "type": "general",
        "code": {
          "page": "https://localhost:3000/index.html"
        },
        "lifetime": "long",
        "actions": [
          {
            "id": "TaskPaneAction",
            "type": "openPage",
            "view": "view1"
          }
        ]
      }
    ],
    "ribbons": [
      {
        "contexts": ["default"],
        "tabs": [
          {
            "id": "FormulaBridgeTab",
            "builtInTabId": "TabHome",
            "groups": [
              {
                "id": "FormulaBridgeGroup",
                "label": "FormulaBridge",
                "icons": [
                  { "size": 16, "url": "assets/icon-16.png" },
                  { "size": 32, "url": "assets/icon-32.png" },
                  { "size": 80, "url": "assets/icon-80.png" }
                ],
                "controls": [
                  {
                    "id": "OpenTaskPane",
                    "type": "button",
                    "label": "FormulaBridge",
                    "icons": [
                      { "size": 16, "url": "assets/icon-16.png" },
                      { "size": 32, "url": "assets/icon-32.png" },
                      { "size": 80, "url": "assets/icon-80.png" }
                    ],
                    "supertip": {
                      "title": "FormulaBridge",
                      "description": "Open the FormulaBridge panel to translate formulas across languages."
                    },
                    "actionId": "TaskPaneAction"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "authorization": {
    "permissions": {
      "resourceSpecific": []
    }
  },
  "validDomains": ["localhost"]
}
